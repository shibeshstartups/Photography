{
  "name": "@studio-erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "wrangler d1 execute studio-erp --local --file=./migrations/0001_initial.sql",
    "db:migrate": "wrangler d1 migrations apply studio-erp --local"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.0",
    "drizzle-orm": "^0.35.0",
    "@studio-erp/shared": "workspace:*",
    "@studio-erp/database": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2024000.0",
    "wrangler": "^3.80.0",
    "drizzle-kit": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}