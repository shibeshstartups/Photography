{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@studio-erp/shared": ["../shared/dist/index.d.ts"],
      "@studio-erp/database": ["../database/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}